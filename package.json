{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Facebook Pages, Posts, Comments and Insights via the Graph API",
  "main": "dist/server/index.js",
  "scripts": {
    "test": "npm run build && npm run lint && npm run smoke",
    "lint": "eslint src",
    "smoke": "node scripts/smoke.js",
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "start": "node dist/server/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "axios": "^1.20.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0"
  }
}
