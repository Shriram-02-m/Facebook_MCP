# ── Meta App #1: Consumer (personal Facebook account — Facebook Login) ──
CONSUMER_APP_ID=your_consumer_app_id_here
CONSUMER_APP_SECRET=your_consumer_app_secret_here

# ── Meta App #2: Business (Page management — Login for Business) ─────────
BUSINESS_APP_ID=your_business_app_id_here
BUSINESS_APP_SECRET=your_business_app_secret_here
BUSINESS_CONFIG_ID=your_configuration_id_here

# ── Ports ──────────────────────────────────────────────────────────────────
# PORT = the LOCAL OAUTH CALLBACK server. Both the consumer AND business
#   login flows share this callback server (one Express listener); each
#   callback is matched to its flow by a random `state`, never by port.
#   http://localhost:$PORT/callback must be registered as a Valid OAuth
#   Redirect URI in BOTH the Consumer and Business app consoles.
#   Default: 3000.  (Only this value is Facebook-facing.)
# MCP_PORT = the MCP Streamable-HTTP transport listener (the /mcp + /health
#   endpoints), used only when the server runs in HTTP mode. It never
#   collides with PORT and is unrelated to OAuth.
#   Default: 3001. Ignored when MCP_TRANSPORT=stdio.
PORT=3000
MCP_PORT=3001

# Optional consumer-scope opt-ins (only enable if your Consumer app is
# allowed to request them in the consent dialog):
#   INCLUDE_EMAIL=true  -> also request the email permission
#   CONNECT_PAGES=true  -> also request pages_* scopes from the Consumer app
INCLUDE_EMAIL=false
CONNECT_PAGES=false
