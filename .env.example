# Facebook Developer App Credentials
# Replace with your App ID and App Secret from https://developers.facebook.com/
APP_ID=your_facebook_app_id_here
APP_SECRET=your_facebook_app_secret_here

# Local OAuth Callback Server Port (Default: 3000)
# Make sure http://localhost:3000/callback is added in Meta Developer Console -> Valid OAuth Redirect URIs
PORT=3000

# Facebook Login for Business Configuration ID
# App Dashboard -> Facebook Login for Business -> Configurations -> Copy
# Token type must be "User access token", asset "Facebook Pages"
# When set, the OAuth URL uses config_id instead of a scope list
CONFIG_ID=your_configuration_id_here
